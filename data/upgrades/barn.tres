[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://core/resources/upgrade_data.gd" id="1_upgrade"]

[resource]
script = ExtResource("1_upgrade")
id = &"barn"
display_name = "Mở rộng chuồng lợn"
description = "Xây thêm ngăn chuồng, nuôi được nhiều lợn hơn (mỗi cấp thêm 2 con)."
