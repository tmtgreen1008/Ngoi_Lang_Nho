[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://core/resources/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker_id = &"ong_bay"
display_name = "Ông Bảy"
first_meeting = PackedStringArray("Hà hà, có người mới về làng! Tôi là ông Bảy, làm ruộng ở đây gần sáu chục năm rồi. Có gì thắc mắc chuyện trồng trọt cứ hỏi ông.", "Chào cháu. Trông cháu còn lạ đất lạ người, ông chỉ cho vài điều nhé.")
greetings = PackedStringArray("Ừ, cháu đó hả. Hôm nay đồng thế nào?", "Chào cháu, ngồi nghỉ chút với ông đi.", "Hà hà, cháu siêng thiệt, ông thấy cháu từ sáng sớm.", "Lại đây lại đây, ông có chuyện muốn kể.")
farewells = PackedStringArray("Đi làm đi cháu, đất không chờ người đâu.", "Ừ, nhớ tưới nước cho cây nghe.", "Hẹn cháu hôm khác, ông còn ngắm đồng.")
lines_general = PackedStringArray("Đất cuốc rồi mới gieo được, nhớ chọn hạt hợp mùa. Gieo sai mùa là cây héo hết.", "Ngủ một giấc sang ngày mới là cây lớn thêm một ngày. Đừng nóng, cây cũng như người, từ từ mới chắc.", "Hồi xưa ông cày bằng trâu, giờ cháu trẻ có cuốc là sướng rồi.", "Cây chín thì thu hoạch ngay, để lâu hoài cũng chẳng thêm được gì đâu.", "Muốn nhiều tiền thì đừng bán lúa sống, nuôi gà lấy trứng, lợn thì nuôi đủ năm ngày hãy bán.")
lines_spring = PackedStringArray("Xuân đến, lúa với rau muống ra đồng thôi. Đất còn ẩm, gieo gì cũng lên.", "Xuân này ông trồng cà chua, nhớ làm giàn cho nó leo.")
lines_summer = PackedStringArray("Hè nắng như đổ lửa, mà dưa hấu với ớt lại ưa nắng. Trời tính hết cả rồi.", "Trưa hè ông không ra đồng đâu, nghỉ dưới gốc chuối cho mát.")
lines_autumn = PackedStringArray("Thu là mùa của bí đỏ với ngô. Thu hoạch xong nhớ để dành mà ăn Tết.", "Lá vàng rơi đầy bờ ruộng, nhìn mà thương. Một năm nữa lại sắp qua.")
lines_winter = PackedStringArray("Đông giá rét, ông chỉ trồng bắp cải với cà rốt. Cái gì chịu rét thì mới sống nổi.", "Trời rét thế này, ngồi bên bếp uống chén trà là nhất.")
friend_lines = PackedStringArray("Cháu biết không, ông thấy cháu giống ông hồi trẻ, không ngại cực.", "Ông có bí quyết này: tưới cây buổi sáng sớm, cây lên xanh gấp đôi.", "Làng này ai cũng quý cháu, ông nói thiệt.")
close_lines = PackedStringArray("Ông già rồi, mai mốt cháu lo cho đồng ruộng làng mình nhé. Ông tin cháu.", "Có cháu về, ông yên tâm lắm. Cảm ơn cháu.")
gift_item_id = &"hat_giong_khoai_lang"
gift_amount = 3
gift_points = 3
gift_text = "Ông có ít hạt giống khoai lang để dành, cháu lấy mà trồng. Khoai lang hợp mùa thu với mùa đông nhé!"
