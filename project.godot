; Huong Que (Rustic Roots) - do an tot nghiep Ky thuat phan mem
config_version=5

[application]

config/name="Hương Quê"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://ui/shop/shop_demo.tscn"

[autoload]

EventBus="*res://core/autoload/event_bus.gd"
TimeManager="*res://core/autoload/time_manager.gd"
ItemDatabase="*res://core/autoload/item_database.gd"
EconomyManager="*res://core/autoload/economy_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
